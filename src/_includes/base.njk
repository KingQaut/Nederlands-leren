{%- set ui = site.ui[p.lang] -%}
<!doctype html>
<html lang="{{ p.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} – {{ site.name }}</title>
<meta name="description" content="{{ ui.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="{{ p.lang }}" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="{{ 'en' if p.lang == 'nl' else 'nl' }}" href="{{ site.url }}{{ altUrl }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ ui.description }}">
<meta property="og:site_name" content="{{ site.name }}">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/style.css">
<script src="/assets/site.js" defer></script>
</head>
<body>
<header class="top">
  <div class="wrap bar">
    <a class="logo" href="{{ p.home }}" aria-label="{{ site.name }} – {{ ui.home }}">
      <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path d="M5 7.5h15a6 6 0 0 1 6 6v4a6 6 0 0 1-6 6h-6l-6 4.5v-4.5H5z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M10 13.5h11M10 17.5h7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      <span>Nederlands<b>Leren</b></span>
    </a>
    <a class="lang" href="{{ altUrl }}" lang="{{ 'en' if p.lang == 'nl' else 'nl' }}" hreflang="{{ 'en' if p.lang == 'nl' else 'nl' }}">{{ ui.otherLang }}</a>
  </div>
</header>
<div class="notice" role="note"><div class="wrap"><span aria-hidden="true">ⓘ</span> {{ ui.disclaimer }} <a href="{{ p.about }}">{{ ui.moreInfo }}</a></div></div>
<main class="wrap">
{{ content | safe }}
</main>
<footer class="foot">
  <div class="wrap">
    <p>{{ ui.footer }}</p>
    <p><a href="{{ p.about }}">{{ ui.about }}</a> · <a href="{{ altUrl }}">{{ ui.otherLang }}</a> · {{ ui.generated }}: {{ library.generated }}</p>
  </div>
</footer>
</body>
</html>
