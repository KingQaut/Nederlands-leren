{%- set ui = site.ui[p.lang] -%}
<!doctype html>
<html lang="{{ p.lang }}" dir="{{ p.dir or 'ltr' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if p.url == p.home %}{{ site.name }} – {{ ui.tagline }}{% else %}{{ title }} – {{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description or ui.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- for l in site.languages %}
<link rel="alternate" hreflang="{{ l.code }}" href="{{ site.url }}{{ p.alts[l.code] }}">
{%- endfor %}
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description or ui.description }}">
<meta property="og:site_name" content="{{ site.name }}">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/style.css">
<link rel="search-index" href="/assets/search-{{ p.lang }}.json" id="search-index">
<script src="/assets/site.js" defer></script>
</head>
<body>
<header class="top">
  <div class="wrap bar">
    <a class="logo" href="{{ p.home }}" aria-label="{{ site.name }} – {{ ui.home }}">
      <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path d="M5 7.5h15a6 6 0 0 1 6 6v4a6 6 0 0 1-6 6h-6l-6 4.5v-4.5H5z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M10 13.5h11M10 17.5h7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      <span>Nederlands<b>Leren</b></span>
    </a>
    {#- Small on purpose: people zoom in to scan it and open the site on their own phone. #}
    <img class="qr" src="/assets/qr.svg" width="30" height="30" alt="{{ ui.qrAlt }}" title="{{ ui.qrAlt }}">
    <form class="search" role="search" onsubmit="return false">
      <input type="search" id="q" placeholder="{{ ui.siteSearchPh }}" aria-label="{{ ui.siteSearch }}" autocomplete="off" data-empty="{{ ui.noHits }}">
      <ul id="hits" hidden></ul>
    </form>
    {#- Language menu: works without JavaScript (tap to open). #}
    <details class="lang">
      <summary aria-label="{{ ui.langMenu }}"><span aria-hidden="true">🌐</span> {% for l in site.languages %}{% if l.code == p.lang %}<span class="long">{{ l.name }}</span><span class="short">{{ l.short }}</span>{% endif %}{% endfor %}</summary>
      <ul>
      {%- for l in site.languages | sort(false, true, "name") %}
        <li><a href="{{ p.alts[l.code] }}" lang="{{ l.code }}" hreflang="{{ l.code }}"{% if l.dir %} dir="{{ l.dir }}"{% endif %}{% if l.code == p.lang %} aria-current="true"{% endif %}>{{ l.name }}</a></li>
      {%- endfor %}
      </ul>
    </details>
  </div>
  <nav class="wrap nav" aria-label="Menu">
    {%- for s in library.sections %}
    <a href="{{ s.url[p.lang] }}"{% if p.section and p.section.key == s.key %} aria-current="true"{% endif %}><i aria-hidden="true">{{ s.icon }}</i> {{ s.title[p.lang] }}</a>
    {%- endfor %}
    <a href="{{ p.choose }}"{% if page.url == p.choose %} aria-current="page"{% endif %}><i aria-hidden="true">🧭</i> {{ ui.chooseNav }}</a>
  </nav>
</header>
{%- set notice %}<div class="notice" role="note"><div class="wrap"><span aria-hidden="true">ⓘ</span> {{ ui.disclaimer }} <a href="{{ p.about }}">{{ ui.moreInfo }}</a></div></div>{% endset %}
<main class="wrap">
{{ content | safe }}
</main>
{#- The disclaimer sits at the bottom of every page, above the footer. #}
{{ notice | safe }}
<footer class="foot">
  <div class="wrap">
    <p>{{ ui.footer }}</p>
    <p>{% for s in library.sections %}<a href="{{ s.url[p.lang] }}">{{ s.title[p.lang] }}</a> · {% endfor %}<a href="{{ p.choose }}">{{ ui.chooseNav }}</a></p>
    <p>{% for l in site.languages | sort(false, true, "name") %}<a href="{{ p.alts[l.code] }}" lang="{{ l.code }}" hreflang="{{ l.code }}"{% if l.dir %} dir="{{ l.dir }}"{% endif %}>{{ l.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
    <p><a href="{{ p.about }}">{{ ui.about }}</a> · {{ ui.generated }}: <span dir="ltr">{{ library.generated }}</span></p>
  </div>
</footer>
</body>
</html>
