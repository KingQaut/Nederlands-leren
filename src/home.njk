---
pagination: { data: library.pages, size: 1, alias: p }
permalink: "{{ p.url }}"
layout: base.njk
eleventyComputed:
  title: "{{ site.ui[p.lang].tagline }}"
---
{%- from "row.njk" import row -%}
{%- set ui = site.ui[p.lang] -%}
<h1 class="sr">{{ site.name }} – {{ ui.tagline }}</h1>
<div class="split">
{%- for s in library.sections %}
  <section class="half {{ s.key }}">
    {% include "art-" + s.key + ".svg" %}
    <small>{{ s.kicker[p.lang] }}</small>
    <h2><a href="{{ s.url[p.lang] }}">{{ s.title[p.lang] }}</a></h2>
    <p>{{ s.intro[p.lang] }}</p>
    <ul>
    {%- for t in s.topics %}
      <li><a href="{{ t.url[p.lang] }}"><i aria-hidden="true">{{ t.icon }}</i> {{ t.title[p.lang] }}</a></li>
    {%- endfor %}
    </ul>
  </section>
{%- endfor %}
</div>

<div class="grid">
  <a class="card tile choose" href="{{ p.choose }}">
    <h2><span aria-hidden="true">🧭</span> {{ ui.chooseCardTitle }}</h2>
    <p>{{ ui.chooseCardText }}</p>
    <span class="btn">{{ ui.chooseCardLink }} →</span>
  </a>
  <section class="card">
    <h2><span aria-hidden="true">🌱</span> {{ ui.freeTitle }}</h2>
    <ul class="mini">
    {%- for r in library.quick %}
      <li><a href="{{ r.url }}" rel="noopener">{{ r.name }}</a><br><span>{{ r.sum[p.lang] }}</span></li>
    {%- endfor %}
    </ul>
  </section>
  <section class="card">
    <h2><span aria-hidden="true">📶</span> {{ ui.levelsCard }}</h2>
    <p>{{ ui.levelsText }}</p>
  </section>
</div>
